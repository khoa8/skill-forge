{
  "name": "skillforge",
  "version": "0.1.0",
  "description": "SkillForge — turn documentation, text, or repositories into validated, portable AI Agent Skills.",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoa8/skill-forge.git"
  },
  "bugs": {
    "url": "https://github.com/khoa8/skill-forge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "verify:provider": "tsx scripts/verify-provider.ts",
    "smoke:production": "node scripts/smoke-production.mjs",
    "docs:check": "tsx scripts/docs-check.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "marked": "^18.0.13",
    "pdfjs-dist": "4.10.38",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "license": "MIT"
}
