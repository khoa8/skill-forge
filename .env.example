# SkillForge environment configuration.
# Copy to .env and fill in only what you need. The bundled demo (mock provider)
# requires NOTHING in this file.

# Generation provider: mock (default, offline) | glm | openai
SKILLFORGE_PROVIDER=mock

# Verify a provider end to end (one small bounded generation → validation):
#   npm run verify:provider
# Uses the variables below. Never prints the API key. Exits nonzero on failure.

# API key for remote providers. Never commit a real key.
# SkillForge refuses to start a remote provider without it and falls back to
# clear errors — it never silently downgrades.
SKILLFORGE_API_KEY=

# Override base URL / model for the OpenAI-compatible adapter.
# Defaults: glm -> https://open.bigmodel.cn/api/paas/v4 (glm-4-flash)
#           openai -> https://api.openai.com/v1 (gpt-4o-mini)
SKILLFORGE_BASE_URL=
SKILLFORGE_MODEL=

# Server binding
PORT=8787
HOST=127.0.0.1

# Filesystem root for the "Local files" source (default: this workspace).
# Paths outside this root are refused. Widen deliberately, e.g.:
# SKILLFORGE_DOCS_ROOT=/Users/you/Documents

# Optional GitHub API token for the "GitHub repo" source. Public repositories
# only — the token exists solely to raise the unauthenticated api.github.com
# rate limit (60 requests/hour per IP). It is sent to api.github.com only,
# never to raw content hosts, and never grants access to private repositories.
SKILLFORGE_GITHUB_TOKEN=
