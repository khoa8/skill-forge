# SkillForge environment configuration.
# Copy to .env and fill in only what you need. The bundled demo (mock provider)
# requires NOTHING in this file. This file is loaded automatically by
# `npm run dev`, `npm start` (compiled), and `npm run verify:provider`;
# variables already set in the shell/process environment take precedence over
# values here, and values here are never logged.

# Generation provider: mock (default, offline) | glm | openai
#
# PRIVACY / DATA EGRESS NOTICE:
# - `mock` (default): completely offline demo provider; makes no model/provider
#   network requests and requires no API key. (Note: source adapters like URL
#   fetch or GitHub repository discovery still perform outbound network calls).
# - Remote providers (`glm`, `openai`): when configured, ordinary generation
#   requests transmit up to the first 60,000 characters of normalized source text
#   plus prompt metadata (source name, requested skill name) to the configured provider
#   endpoint (SKILLFORGE_BASE_URL). Local files, pasted text, URLs, samples, and
#   documentation-mode files leave your machine when remote providers are enabled.
#   Do not configure a remote provider for sensitive or confidential source material
#   unless you intend to disclose that material to that provider.
# - GitHub codebase mode: transmits only bounded structured metadata (frameworks,
#   entrypoints, manifest metadata without script definitions, test evidence, max
#   16 KB JSON); command bodies, manifest script definitions, convention text,
#   and raw inspected source code are not transmitted.
SKILLFORGE_PROVIDER=mock

# Verify a provider end to end (one small bounded generation → validation):
#   npm run verify:provider
# Uses the variables below. Never prints the API key. Exits nonzero on failure.

# API key for remote providers. Never commit a real key.
# Used as the Bearer credential in the Authorization header for requests to
# the configured provider endpoint (SKILLFORGE_BASE_URL).
# SkillForge refuses to start a remote provider without it and falls back to
# clear errors — it never silently downgrades.
SKILLFORGE_API_KEY=

# Override base URL / model for the OpenAI-compatible adapter.
# Defaults: glm -> https://open.bigmodel.cn/api/paas/v4 (glm-4-flash)
#           openai -> https://api.openai.com/v1 (gpt-4o-mini)
SKILLFORGE_BASE_URL=
SKILLFORGE_MODEL=

# Server binding. The supported deployment model is local / trusted
# self-hosted use: SkillForge has NO built-in authentication or tenant
# isolation.
#
# Loopback mode (default HOST=127.0.0.1): strictly enforces inbound HTTP Host
# header validation (accepting only localhost, 127.0.0.1, [::1], ::1), closing
# browser-based DNS-rebinding attacks.
PORT=8787
HOST=127.0.0.1

# Allowed hosts for inbound HTTP Host validation.
# Comma-separated list of hostnames/IPs permitted in inbound Host headers
# (e.g. SKILLFORGE_ALLOWED_HOSTS=192.168.1.50,my-server.lan). Wildcards (*)
# are not permitted.
# In loopback mode, canonical local loopback hosts are automatically permitted.
# REQUIRED when HOST is bound to a non-loopback address (e.g. 0.0.0.0 or LAN IP);
# binding to a non-loopback address without this setting fails closed at startup.
SKILLFORGE_ALLOWED_HOSTS=

# Set to 1 ONLY if you understand the risk of exposing the unauthenticated
# server beyond loopback; it silences the non-loopback binding warning.
SKILLFORGE_ACKNOWLEDGE_EXPOSURE=

# Filesystem root for the "Local files" source (default: this workspace).
# Paths outside this root are refused. Widen deliberately, e.g.:
# SKILLFORGE_DOCS_ROOT=/Users/you/Documents
#
# SECURITY: SKILLFORGE_DOCS_ROOT is the filesystem trust boundary. Any
# documentation-like file inside it (allowed extension, within size bounds)
# may be read — including dotfiles such as .secret-notes.md. (.env itself is
# not readable only because its extension is not in the allowlist, not
# because dotfiles are excluded.) Point this at a docs-only directory if the
# default workspace contains sensitive text/Markdown files.

# Persistence root for generated skills (default: <cwd>/.data). Skills live
# under <root>/skills. Set this only if you want the store outside the
# workspace, e.g.:
# SKILLFORGE_DATA_ROOT=/Users/you/skillforge-data

# Optional.
# SkillForge can read PUBLIC GitHub repositories without this token.
# This token is used only to increase GitHub API rate limits for public-repository
# discovery/tree requests.
# Private repositories are not supported, even if this token can access them.
# The token is sent only to api.github.com, never to raw content hosts.
SKILLFORGE_GITHUB_TOKEN=
